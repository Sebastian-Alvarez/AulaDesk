# Finales de línea LF en todos los archivos de texto, en Windows y en Linux
* text=auto eol=lf

# Scripts de Windows que necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
