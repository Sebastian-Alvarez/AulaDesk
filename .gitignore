# ---------------------------------------------------------------
# JetBrains (RustRover): solo los archivos personales.
# Basado en github/gitignore Global/JetBrains.gitignore.
# ---------------------------------------------------------------
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/copilot.data.migration.*.xml
.idea/caches/
.idea/sonarlint/
.idea/sonarlint.xml
.idea/replstate.xml
*.iws
# HTTP Client: peticiones guardadas y variables privadas (lineamiento 7.1)
.idea/httpRequests/
http-client.private.env.json
# Rutas locales a la base SQLite: distintas en cada máquina
.idea/**/dataSources.xml
.idea/**/sqldialects.xml

